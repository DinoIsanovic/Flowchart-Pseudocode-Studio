{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flowchart Studio",
  "version": "0.9.0",
  "identifier": "com.dinoisanovic.flowchartstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowchart & Pseudocode Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": [
          "'self'",
          "data:",
          "https://fonts.gstatic.com"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://generativelanguage.googleapis.com"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "publisher": "Dino Isanovi\u0107",
    "copyright": "Copyright 2026 Dino Isanovi\u0107",
    "license": "Apache-2.0",
    "category": "Education",
    "shortDescription": "Bi-directional flowchart and pseudocode editor",
    "longDescription": "Write pseudocode and get a laid-out flowchart, or draw the flowchart and get the pseudocode back, in English, German or Bosnian.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
